# Copy to .env. Every setting below is read from the container environment -
# nothing is hardcoded in docker-compose.yml, the Dockerfile, or the code.
# The mosquitto broker's own config file is generated by our
# "mosquitto-config" service (petlibro_relay.mosquitto_config) from these
# same variables - the mosquitto image itself is never modified.

# --- relay: device identity (optional - see docs/setup.md) --------------

# You do NOT need to fill these in. Once the DNS override points the feeder
# at this relay, its first connection is captured automatically by
# CredentialCaptureProxy and stored in the device registry - the relay picks
# it up from there. Set these only to force a specific identity (e.g. to run
# the relay before the feeder has ever connected locally, as we did during
# development against a manually-extracted identity).
# PETLIBRO_DEVICE_CLIENT_ID=
# PETLIBRO_DEVICE_USERNAME=
# PETLIBRO_DEVICE_PASSWORD=

# --- relay: required for the docker-compose topology ---------------------

# Hostname of the local broker, as seen from the "relay" container. Must
# match the mosquitto service name in docker-compose.yml (its default,
# "localhost", only makes sense running the relay outside Docker).
PETLIBRO_LOCAL_HOST=mosquitto

# --- relay: optional overrides (defaults shown) -------------------------

# PETLIBRO_TOPIC_PREFIX=dl/PLAF203/<client_id>
# PETLIBRO_UPSTREAM_HOST=mqtt.us.petlibro.com
# PETLIBRO_UPSTREAM_PORT=1883
# For a deliberate local outage test only, use 127.0.0.1:65534 (an unused
# port). Never point the upstream at 127.0.0.1/localhost/::1 on port 1883:
# it is the local capture-proxy/broker path and startup will reject the loop.
# PETLIBRO_LOCAL_PORT=1883
# PETLIBRO_KEEPALIVE_SECONDS=90
# PETLIBRO_STATE_CACHE_PATH=/data/state_cache.json
# PETLIBRO_QUEUE_DB_PATH=/data/relay_queue.sqlite3
# PETLIBRO_DEVICE_REGISTRY_DB_PATH=/data/device_registry.sqlite3

# A learned identity is forgotten if its device hasn't connected within this
# window, so a stale or bogus entry ages out instead of lingering. Not
# validated against the cloud on purpose: the relay must keep working while
# the cloud is down, so cloud availability never gates it.
# PETLIBRO_DEVICE_RETENTION_HOURS=72

# One relay bridges as many feeders as connect; each keeps its own identity
# and its own cloud session. With auto-enrollment on, a newly learned device
# is bridged straight away. Set it to false to have new devices recorded as
# candidates instead - visible on the dashboard, never bridged - so adding
# one is deliberate rather than a consequence of LAN access.
# PETLIBRO_AUTO_ENROLL=true
# PETLIBRO_MAX_QUEUE_SIZE=5000
# PETLIBRO_LOG_LEVEL=INFO

# Temporary diagnosis: log upstream PETLIBRO /device/service/sub JSON at INFO
# before it is forwarded unchanged to the local broker. This can reveal the
# exact setting updates the official app sends. Functional fields are shown;
# passwords, tokens, credentials and TUTK/Kalay fields are redacted.
# PETLIBRO_LOG_UPSTREAM_SERVICE_PAYLOADS=false

# Temporary diagnosis: log a sanitized DEVICE_START_EVENT from the feeder,
# including its uuid when present. Disabled by default; routing is unchanged.
# PETLIBRO_LOG_DEVICE_START_EVENT=false

# --- controlled device-to-cloud replay (defaults shown) -----------------

# Backlog is replayed as background traffic after a successful upstream
# session, while new live device messages remain prioritized. Values are per
# relay container; both message-rate limits apply to every replay publish.
# Jitter only adds spacing, so it never exceeds either configured rate.
# PETLIBRO_REPLAY_RATE_PER_DEVICE=5
# PETLIBRO_REPLAY_RATE_GLOBAL=20
# PETLIBRO_REPLAY_START_DELAY=1.5
# PETLIBRO_REPLAY_JITTER=0.15

# --- upstream DNS (defaults shown) ---------------------------------------

# The relay must resolve mqtt.us.petlibro.com to the REAL cloud, even though
# your LAN DNS rewrites that same name to this host for the feeder. These
# pin public resolvers for the relay container so it isn't caught by its own
# override (see docs/setup.md).
# PETLIBRO_UPSTREAM_DNS_PRIMARY=1.1.1.1
# PETLIBRO_UPSTREAM_DNS_SECONDARY=9.9.9.9

# --- credential capture proxy (defaults shown) ---------------------------

# Port the "relay" container listens on inside the container - this is what
# the feeder actually connects to after the DNS override (see docs/setup.md).
# PETLIBRO_CAPTURE_PROXY_PORT=1883

# Host-side port mapping (docker-compose.yml "${PETLIBRO_HOST_PORT}:...").
# This is the port your DNS override should point the MQTT hostnames at.
# PETLIBRO_HOST_PORT=1883

# --- mosquitto: local broker, internal only (defaults shown) ------------

# Port mosquitto listens on inside its own container. Keep this equal to
# PETLIBRO_LOCAL_PORT above - that's how the relay and the capture proxy
# both know where to reach it.
# MOSQUITTO_LISTENER_PORT=1883

# No auth on the local broker (LAN-only, and only reachable through the
# capture proxy) - the feeder connects with its own credentials but
# mosquitto doesn't need to validate them locally.
# MOSQUITTO_ALLOW_ANONYMOUS=true

# How long mosquitto keeps a persistent (clean_session=false) client's
# session and queued messages after it disconnects.
# MOSQUITTO_PERSISTENT_CLIENT_EXPIRATION=7d

# Required so mosquitto queues QoS 0 messages for a temporarily offline
# feeder instead of dropping them.
# MOSQUITTO_QUEUE_QOS0_MESSAGES=true
# MOSQUITTO_MAX_QUEUED_MESSAGES=1000

# --- local responder (all default OFF) -----------------------------------

# Master switch. When off, the relay is a pure pipe and never answers the
# feeder on the cloud's behalf. The per-function flags below only take
# effect when this is on.
# PETLIBRO_LOCAL_RESPONDER=false

# Answer the feeder's NTP request locally while the cloud is unreachable.
# The reply mirrors this firmware's own cloud payload (NTP_SYNC with DST
# transition fields); set PETLIBRO_DEVICE_TIMEZONE for it to be correct.
# PETLIBRO_LOCAL_NTP=false

# Answer NTP locally even when the cloud IS reachable.
# PETLIBRO_LOCAL_NTP_ALWAYS=false

# Serve the last settings / feeding plans the cloud pushed, while it is
# unreachable. Only ever answers from a complete cached value; never invents.
# PETLIBRO_LOCAL_CONFIG=false
# PETLIBRO_LOCAL_FEEDING_PLAN=false

# IANA time zone of the feeder, used to compute the NTP reply's UTC offset
# and DST transitions. Must match the timezone set on the PETLIBRO account.
# PETLIBRO_DEVICE_TIMEZONE=UTC

# How long a locally answered msgId is remembered, so a late cloud answer to
# the same request is suppressed instead of reaching the device twice.
# PETLIBRO_HANDLED_MSG_ID_TTL_SECONDS=120

# PETLIBRO_STATE_SHADOW_DB_PATH=/data/state_shadow.sqlite3

# Clock drift below which no NTP_SYNC is sent - the cloud leaves a device
# whose clock is already correct unanswered, and the relay mirrors that.
# PETLIBRO_CLOCK_DRIFT_TOLERANCE_SECONDS=10

# --- read-only observability dashboard (default OFF) --------------------

# The dashboard only exposes diagnostics. It cannot publish MQTT, change the
# feeder, or alter relay state. Keep it LAN-only; do not expose this port to
# the Internet because it displays device identifiers, topics and logs.
# PETLIBRO_WEB_ENABLED=false
# PETLIBRO_WEB_HOST=0.0.0.0
# PETLIBRO_WEB_PORT=8080
# PETLIBRO_WEB_HOST_PORT=8080

# --- optional camera sidecars (default OFF) ------------------------------

# The relay learns a verified 20-character camera UID from DEVICE_START_EVENT,
# persists it in its SQLite State Shadow, then registers it asynchronously to
# this internal sidecar. It neither starts a camera session nor exposes a UID.
# PETLIBRO_CAMERA_BRIDGE_ENABLED=false
# Optional explicit sidecar endpoint. Takes precedence over HOST/PORT, and is
# required when the bridge uses host networking (for example host.docker.internal).
# PETLIBRO_CAMERA_BRIDGE_URL=http://host.docker.internal:8081
# PETLIBRO_CAMERA_BRIDGE_HOST=camera-bridge
# PETLIBRO_CAMERA_BRIDGE_PORT=8081
# PETLIBRO_CAMERA_BRIDGE_TIMEOUT_SECONDS=1
# PETLIBRO_CAMERA_BRIDGE_RECONCILE_INTERVAL_SECONDS=5
# PETLIBRO_CAMERA_DISCOVERY_BROADCAST_FALLBACK=true

# The relay performs only a read-only GET /api/streams to the internal
# go2rtc sidecar. It does not configure a PLAF203 stream or expose go2rtc's
# administrative API. Leave disabled until the sidecar is deliberately used.
# PETLIBRO_GO2RTC_ENABLED=false
# PETLIBRO_GO2RTC_HOST=go2rtc
# PETLIBRO_GO2RTC_PORT=1984
# PETLIBRO_GO2RTC_TIMEOUT_SECONDS=1

# Optional build/deployment metadata shown in the System tab.
# PETLIBRO_GIT_COMMIT=unknown
